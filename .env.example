# Copy to .env (cp, not mv — keep this template) and fill in. .env is gitignored:
# never commit real keys. Private keys live in files outside the repo.

# DEMO exchange (https://demo.kalshi.co — separate account and keys) for `weather-edge paper`.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# PRODUCTION (https://kalshi.com) for `weather-edge shadow`: read-only, no orders are sent.
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=
